{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Genzineers Fashion Tool",
  "version": "0.2.0",
  "identifier": "com.genzineers.fashiontool",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "title": "Genzineers Fashion Tool", "width": 1400, "height": 900, "minWidth": 360, "minHeight": 560, "resizable": true, "dragDropEnabled": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "appimage", "deb", "rpm"],
    "publisher": "Genzineers",
    "homepage": "https://genzineers.com",
    "copyright": "© 2026 Genzineers. All rights reserved.",
    "category": "GraphicsAndDesign",
    "shortDescription": "Design, simulate and produce clothing, bags, hats and jewelry",
    "longDescription": "Genzineers Fashion Tool: design, 3D-simulate, assemble and produce clothing, hats, bags and jewelry, with AI connectors (MCP/API) and factory-ready tech packs. Free for personal use; commercial use requires a licence from Genzineers.",
    "licenseFile": "../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
